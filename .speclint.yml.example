# speclint configuration. Drop this file at the repo root as
# `.speclint.yml`. All keys are optional — defaults shown below.
# See README.md → Configuration for the full reference.

# Rule packages to load, in order. Later packages override earlier ones
# by rule id. Each package registers via the `speclint.rules` entry point.
packages:
  - default

# Spec discovery roots. Omit to use the built-in default list (specs/,
# docs/specs/, features/, rfcs/, .kiro/specs/, openspec/, …). Set this
# to *replace* the defaults; use `extra_roots` to add to them.
# roots:
#   - "specs"
#   - "docs/rfcs"

# Add roots without replacing the defaults — handy for ADR-style or
# bespoke layouts.
extra_roots: []

# fnmatch patterns (relative to repo root) to skip during discovery.
ignore: []

# Opt-in metadata sidecar. When set, each spec folder is checked for
# a YAML file with this name; its contents land in `ir.metadata` for
# rules that need structured data (refs-resolve, refs-coupling,
# no-tbd's draft-skip). No schema is imposed.
metadata:
  sidecar: null            # e.g. "contract.yaml", "spec.yml", "meta.yml"

# Per-rule overrides. A bare string sets severity; a mapping passes options.
# Examples:
#   no-tbd: error                       # bump severity
#   no-weasel-words: off                # disable
#   refs-resolve:
#     # `field` reads list-of-strings from metadata. Use a dotted path
#     # with [*] to walk nested shapes — e.g. autopod-style contracts:
#     field: required_facts[*].artifact.path
#   refs-coupling:
#     field: required_facts[*].artifact.path
#   refs-infer-coupling:
#     severity: warn                    # bump from info if prose mentions
#                                       # are reliable enough on your specs
#   no-weasel-words-llm:
#     severity: warn                    # confirmed claims promoted to warn
#   heading-redundancy:
#     severity: warn
#     threshold: 0.92                   # Tier 2 similarity threshold
rules: {}

# Exit-code threshold. error (default) fails only on errors;
# warn fails on any warning; never always exits 0.
fail_on: error

# Tier 3 LLM rules. `no-weasel-words-llm` ships in the default package —
# it's a second-pass classifier that promotes low-signal weasel hits
# (fast/just/simply/easy/modern) from `info` to `warn` when a small
# model confirms they're real unmeasurable claims. Skipped silently
# unless a transport is available.
llm:
  enabled: true
  transport: auto       # auto | api | openai | cli | codex
  model: null           # null = each transport's default (Haiku for api/cli)
  cache: .speclint-cache/llm/
